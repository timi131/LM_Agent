# Ollama
OLLAMA_HOST=http://localhost:11434
LM_AGENT_MODEL=qwen2.5:7b
LM_AGENT_EMBED_MODEL=embeddinggemma

# Папки
LM_AGENT_WORKSPACE=./workspace
# Где агенту можно работать с файлами (через ":"). Запись вне workspace — с подтверждением.
LM_AGENT_FILE_ROOTS=~
LM_AGENT_DOCS=./docs
LM_AGENT_DATA=~/.lm_agent
LM_AGENT_SERVICES=./services.json

# Поведение
LM_AGENT_MAX_STEPS=8
LM_AGENT_TEMPERATURE=0.2
# Окно контекста (токены). Больше — точнее на длинных страницах/документах, но больше памяти.
LM_AGENT_NUM_CTX=16384
LM_AGENT_COMMAND_TIMEOUT=60
# 1 — выполнять команды, запись файлов, письма и изменяющие запросы без вопросов (опасно)
LM_AGENT_AUTO_APPROVE=0
# Включённые наборы инструментов
LM_AGENT_TOOLKITS=basic,files,web,shell,services,mail,docs,memory

# Токены сервисов (подставляются в services.json как ${VAR})
OKOCRM_TOKEN=
GITHUB_TOKEN=

# Почта (для Gmail/Яндекса нужен пароль приложения)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465

# Веб-чат
LM_AGENT_WEB_HOST=127.0.0.1
LM_AGENT_WEB_PORT=8000
# Обязателен, если сервер доступен не только с этого компьютера
LM_AGENT_WEB_TOKEN=
