# Настройки агента. Скопируйте в .env и раскомментируйте только то, что хотите изменить:
# у закомментированных строк действуют значения по умолчанию (они указаны ниже).

# --- Модели (Ollama) ---
# OLLAMA_HOST=http://localhost:11434
# LM_AGENT_MODEL=qwen2.5:7b
# LM_AGENT_EMBED_MODEL=embeddinggemma

# --- Папки и база знаний ---
# LM_AGENT_WORKSPACE=./workspace
# Где агенту можно работать с файлами (через ":"). Запись вне workspace — с подтверждением.
# LM_AGENT_FILE_ROOTS=~
# Документы для поиска; сюда же попадают файлы, загруженные в веб-чате
# LM_AGENT_DOCS=./docs
# Дополнительные базы знаний только для чтения — папки или файлы через ":"
# LM_AGENT_KNOWLEDGE=~/Desktop/ddd/knowledge/faq.md:~/Desktop/ddd/knowledge/nashi-uslugi.md
# LM_AGENT_DATA=~/.lm_agent
# LM_AGENT_SERVICES=./services.json

# --- Поведение ---
# LM_AGENT_MAX_STEPS=15
# LM_AGENT_TEMPERATURE=0.2
# Окно контекста (токены): больше — точнее на длинных страницах, но больше памяти
# LM_AGENT_NUM_CTX=16384
# LM_AGENT_COMMAND_TIMEOUT=60
# Включённые наборы инструментов (по умолчанию все)
# LM_AGENT_TOOLKITS=basic,files,web,browser,shell,services,mail,docs,tables,reports,memory
# 1 — выполнять команды, запись файлов, письма и изменяющие запросы без вопросов (опасно)
# LM_AGENT_AUTO_APPROVE=0

# --- Браузер ---
# 1 — без окна (в веб-чате по умолчанию без окна: экран виден в панели «Браузер»)
# LM_AGENT_BROWSER_HEADLESS=1
# Когда спрашивать подтверждение: risky | all | none
# LM_AGENT_BROWSER_CONFIRM=risky
# auto | chromium | chrome | msedge
# LM_AGENT_BROWSER_CHANNEL=auto

# --- Веб-чат ---
# LM_AGENT_WEB_HOST=127.0.0.1
# LM_AGENT_WEB_PORT=8000
# Обязателен для доступа из локальной сети (lm-agent-web --lan):
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# LM_AGENT_WEB_TOKEN=
# 1 — HTTPS с автоматическим сертификатом (нужен для микрофона с других устройств)
# LM_AGENT_WEB_HTTPS=1

# --- Telegram-бот (стартует вместе с lm-agent-web или отдельно: lm-agent-bot) ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# Кому можно пользоваться ботом: числовые id и/или @username через запятую
# TELEGRAM_ALLOWED_USERS=@username
# Если Telegram недоступен напрямую: http://… или socks5://…
# TELEGRAM_PROXY=

# --- Голос (faster-whisper) ---
# tiny | base | small | medium | large-v3 | large-v3-turbo | off
# LM_AGENT_WHISPER_MODEL=small
# Язык речи; auto — определять автоматически (на коротких фразах ошибается)
# LM_AGENT_WHISPER_LANGUAGE=ru
# Слова-подсказки для распознавания; «-» — без подсказки (по умолчанию — термины REDSMS)
# LM_AGENT_WHISPER_PROMPT=

# --- Внешние сервисы и почта ---
# Токены сервисов (подставляются в services.json как ${VAR})
# OKOCRM_TOKEN=
# GITHUB_TOKEN=
# Почта (для Gmail/Яндекса нужен пароль приложения)
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=
# IMAP_HOST=imap.yandex.ru
# IMAP_PORT=993
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
