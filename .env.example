# Ollama
OLLAMA_HOST=http://localhost:11434
LM_AGENT_MODEL=qwen2.5:7b
LM_AGENT_EMBED_MODEL=embeddinggemma

# Папки
LM_AGENT_WORKSPACE=./workspace
# Где агенту можно работать с файлами (через ":"). Запись вне workspace — с подтверждением.
LM_AGENT_FILE_ROOTS=~
LM_AGENT_DOCS=./docs
LM_AGENT_DATA=~/.lm_agent
LM_AGENT_SERVICES=./services.json

# Поведение
LM_AGENT_MAX_STEPS=15
LM_AGENT_TEMPERATURE=0.2
# Окно контекста (токены). Больше — точнее на длинных страницах/документах, но больше памяти.
LM_AGENT_NUM_CTX=16384
LM_AGENT_COMMAND_TIMEOUT=60
# Браузер: 1 — без окна; когда спрашивать подтверждение: risky | all | none
LM_AGENT_BROWSER_HEADLESS=0
LM_AGENT_BROWSER_CONFIRM=risky
# auto | chromium | chrome | msedge
LM_AGENT_BROWSER_CHANNEL=auto
# 1 — выполнять команды, запись файлов, письма и изменяющие запросы без вопросов (опасно)
LM_AGENT_AUTO_APPROVE=0
# Включённые наборы инструментов
LM_AGENT_TOOLKITS=basic,files,web,browser,shell,services,mail,docs,tables,memory

# Токены сервисов (подставляются в services.json как ${VAR})
OKOCRM_TOKEN=
GITHUB_TOKEN=

# Почта (для Gmail/Яндекса нужен пароль приложения)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465

# Веб-чат
LM_AGENT_WEB_HOST=127.0.0.1
LM_AGENT_WEB_PORT=8000
# Обязателен для доступа из локальной сети (lm-agent-web --lan)
LM_AGENT_WEB_TOKEN=
# 1 — HTTPS с автоматическим сертификатом (нужен для микрофона с других устройств)
LM_AGENT_WEB_HTTPS=0

# Telegram-бот (стартует вместе с lm-agent-web или отдельно: lm-agent-bot)
TELEGRAM_BOT_TOKEN=
# Кому можно пользоваться ботом: числовые id и/или @username через запятую
TELEGRAM_ALLOWED_USERS=
# Если Telegram недоступен напрямую: http://… или socks5://…
TELEGRAM_PROXY=
# Распознавание голосовых (faster-whisper): tiny | base | small | medium | large-v3 | off
LM_AGENT_WHISPER_MODEL=small
# Язык речи (ru, en…); пусто — определять автоматически
LM_AGENT_WHISPER_LANGUAGE=
